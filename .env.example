# Copy to .env (or export in your shell). Without NEBIUS_API_KEY the app runs in demo mode.
NEBIUS_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Agent brain (NVIDIA Nemotron). Alternatives: nvidia/Nemotron-3-Ultra-550b-a55b, nvidia/Nemotron-3_5-Lightning
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# FAX image -> raw transcription only
# Leave empty to auto-pick (NVIDIA VL model preferred), or set e.g. nvidia/Nemotron-3.5-Super-VL
VISION_MODEL=
PORT=3000
# Optional
# LLM_TIMEOUT_MS=120000
# LLM_MAX_TOKENS=8192
# MANUAL_SECONDS_PER_SHEET=300
# LEDGER_PATH=data/orders.csv
